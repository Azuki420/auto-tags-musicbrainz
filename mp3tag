# -----------------------------------------------------------------------------
# Filename Sanitization & Target Formatting
# -----------------------------------------------------------------------------
def sanitize_filename(name: str) -> str:
    """Sanitize strings for safe filesystem usage across Linux, SMB/CIFS, FAT/NTFS."""
    s = name.replace("/", "-").replace("\\", "-")
    s = s.replace(":", " -")
    s = s.replace('"', "'")
    s = re.sub(r'[*?<>|]', "", s)
    s = re.sub(r"\s+", " ", s).strip()
    s = re.sub(r" - -+", " -", s)
    return s.strip(". ")

def get_target_filename(assignment: "TrackAssignment", release: "ReleaseMetadata") -> str:
    """
    Format filename based on disc total:
      When 1 disc:
        01. BLACKPINK - BOOMBAYAH.flac
      When 2 or more discs:
        1.01. BABYMETAL - FUTURE METAL.flac
    """
    meta = assignment.meta
    ext = assignment.local_file.suffix.lower()
    artist_clean = sanitize_filename(meta["artist"])
    title_clean = sanitize_filename(meta["title"])
    track_num = meta["track"]
    disc_num = meta["disc"]
    disctotal = release.disc_total

    if disctotal >= 2:
        return f"{disc_num}.{track_num:02d}. {artist_clean} - {title_clean}{ext}"
    else:
        return f"{track_num:02d}. {artist_clean} - {title_clean}{ext}"

def ensure_jpeg(img_bytes: bytes) -> bytes:
    """Converts image bytes to JPEG format if not already JPEG."""
    if img_bytes.startswith(b"\xff\xd8\xff"):
        return img_bytes
    try:
        with Image.open(io.BytesIO(img_bytes)) as img:
            rgb_img = img.convert("RGB")
            out = io.BytesIO()
            rgb_img.save(out, format="JPEG", quality=95)
            return out.getvalue()
    except Exception as e:
        UI.warn(f"Failed to convert image to JPEG: {e}")
        return img_bytes

# -----------------------------------------------------------------------------
# Catalog Number Resolver
# -----------------------------------------------------------------------------
def resolve_catalog_numbers(label_info_list: List[Dict[str, Any]], disc_total: int) -> Dict[int, str]:
    """
    Returns a dict mapping disc_number (1-indexed) -> catalog_number string.
    If multiple catalog numbers are provided (either across multiple label-info entries or in a range/comma/slash),
    each disc gets its distinct catalog number.
    If only 1 catalog number is provided and cannot be expanded as a range, all discs use that one.
    """
    if not label_info_list:
        return {d: "" for d in range(1, disc_total + 1)}

    raw_cats = []
    for li in label_info_list:
        cat = li.get("catalog-number")
        if cat and str(cat).strip():
            raw_cats.append(str(cat).strip())

    if not raw_cats:
        return {d: "" for d in range(1, disc_total + 1)}

    # Case 1: Multiple catalog numbers provided across label-info entries
    if len(raw_cats) > 1:
        disc_cats = {}
        for d in range(1, disc_total + 1):
            disc_cats[d] = raw_cats[d - 1] if d <= len(raw_cats) else raw_cats[-1]
        return disc_cats

    # Case 2: Exactly 1 catalog number provided. Check if it contains a range or slash/comma list
    single = raw_cats[0]

    # Check comma or slash or semicolon separated list: e.g. "IMAE-00046 / IMAE-00047"
    if any(sep in single for sep in [" / ", " /", "/ ", ", ", ","]):
        parts = [p.strip() for p in re.split(r"[/,;]", single) if p.strip()]
        if len(parts) >= disc_total:
            return {d: parts[d - 1] for d in range(1, disc_total + 1)}

    # Check range notation: e.g. LC-2545~54, IMAE-00046~47, IMAE-00046~7, ABC-001-3
    m = re.match(r"^(.*?)(\d+)\s*[~/–-]\s*(\d+)$", single)
    if m:
        prefix, start_str, end_str = m.group(1), m.group(2), m.group(3)
        start_num = int(start_str)
        if len(end_str) < len(start_str):
            cutoff = len(start_str) - len(end_str)
            full_end_str = start_str[:cutoff] + end_str
            end_num = int(full_end_str)
        else:
            end_num = int(end_str)

        count = end_num - start_num + 1
        if count >= disc_total or count > 1:
            pad_len = len(start_str)
            disc_cats = {}
            for idx, num in enumerate(range(start_num, start_num + disc_total), 1):
                disc_cats[idx] = f"{prefix}{num:0{pad_len}d}"
            return disc_cats

    # Case 3: Only 1 catalog number provided without range
    return {d: single for d in range(1, disc_total + 1)}

# -----------------------------------------------------------------------------
# Rate-Limited MusicBrainz Client
# -----------------------------------------------------------------------------
class MusicBrainzClient:
    BASE_URL = "https://musicbrainz.org/ws/2"
    COVER_URL = "https://coverartarchive.org"

    def __init__(self, min_interval: float = 1.0):
        self.min_interval = min_interval
        self.last_req_time = 0.0
        self.session = requests.Session()
        self.session.headers.update({"User-Agent": USER_AGENT})

    def _throttle(self):
        elapsed = time.time() - self.last_req_time
        if elapsed < self.min_interval:
            time.sleep(self.min_interval - elapsed)
        self.last_req_time = time.time()

    def get_json(self, url: str, params: Optional[Dict[str, str]] = None) -> Optional[Dict[str, Any]]:
        self._throttle()
        for attempt in range(3):
            try:
                r = self.session.get(url, params=params, timeout=15)
                if r.status_code == 200:
                    return r.json()
                elif r.status_code == 404:
                    return None
                elif r.status_code in (503, 429):
                    time.sleep(1.5 * (attempt + 1))
                    continue
                else:
                    return None
            except requests.RequestException:
                time.sleep(1.0)
        return None

    def search_releases(self, query: str, limit: int = 15) -> List[Dict[str, Any]]:
        url = f"{self.BASE_URL}/release/"
        params = {"query": query, "limit": str(limit), "fmt": "json"}
        data = self.get_json(url, params=params)
        return data.get("releases", []) if data else []

    def get_release_details(self, release_id: str) -> Optional[Dict[str, Any]]:
        url = f"{self.BASE_URL}/release/{release_id}"
        params = {
            "inc": "recordings+artists+labels+media+release-groups+discids",
            "fmt": "json"
        }
        return self.get_json(url, params=params)

    def fetch_cover_art(self, release_id: str, release_group_id: Optional[str] = None) -> Optional[Tuple[bytes, str]]:
        urls_to_try = [
            f"{self.COVER_URL}/release/{release_id}/front-1200",
            f"{self.COVER_URL}/release/{release_id}/front",
        ]
        if release_group_id:
            urls_to_try.append(f"{self.COVER_URL}/release-group/{release_group_id}/front")

        for u in urls_to_try:
            try:
                r = self.session.get(u, timeout=15, allow_redirects=True)
                if r.status_code == 200 and r.content:
                    content = r.content
                    mime = "image/jpeg"
                    if content.startswith(b"\x89PNG\r\n\x1a\n"):
                        mime = "image/png"
                    elif content.startswith(b"\xff\xd8\xff"):
                        mime = "image/jpeg"
                    return content, mime
            except requests.RequestException:
                continue
        return None

# -----------------------------------------------------------------------------
# Folder Parsing & Query Construction
# -----------------------------------------------------------------------------
class FolderInfo:
    def __init__(self, folder_path: Path):
        self.path = folder_path.resolve()
        self.name = folder_path.name
        self.artist_hint: Optional[str] = None
        self.album_hint: str = self.name
        self.year_hint: Optional[str] = None
        self._parse()

    def _parse(self):
        clean = self.name
        m_year = re.search(r"[\[\(](\d{4})(?:-\d{2}-\d{2})?[\]\)]", clean)
        if m_year:
            self.year_hint = m_year.group(1)
            clean = clean.replace(m_year.group(0), " ").strip()

        clean = re.sub(
            r"[\[\(](?:flac|mp3|wav|cd|web|vinyl|\d{2,4}k|\d{2,4}kbps|24bit|16bit|cbr|vbr|remastered|ost)[\]\)]",
            "", clean, flags=re.IGNORECASE
        )
        clean = re.sub(r"\[[^\]]*\]|\([^\)]*\)", " ", clean)
        clean = re.sub(r"\s+", " ", clean).strip()

        for sep in [" - ", " – ", " — "]:
            if sep in clean:
                parts = clean.split(sep, 1)
                self.artist_hint = parts[0].strip()
                self.album_hint = parts[1].strip()
                return

        self.album_hint = clean

# -----------------------------------------------------------------------------
# Local File Discovery & Analysis
# -----------------------------------------------------------------------------
class LocalTrack:
    def __init__(self, file_path: Path, disc_num: Optional[int] = None, track_num: Optional[int] = None):
        self.file_path = file_path
        self.disc_num = disc_num
        self.track_num = track_num
        self.existing_title: Optional[str] = None
        self.existing_artist: Optional[str] = None
        self.title_hint: str = ""

def clean_track_title_hint(stem: str) -> str:
    s = stem
    s = re.sub(r"^(\d{1,2}[.\-_]\d{1,3}|\d{1,3})[\s.\-_]+", "", s)
    for sep in [" - ", " – ", " — "]:
        if sep in s:
            s = s.split(sep, 1)[-1]
            break
    return s.strip()

def scan_audio_files(folder_path: Path) -> List[LocalTrack]:
    audio_files: List[Path] = []
    for root, _, files in os.walk(folder_path):
        for f in files:
            p = Path(root) / f
            if p.suffix.lower() in AUDIO_EXTENSIONS:
                audio_files.append(p)

    audio_files.sort(key=lambda p: [int(c) if c.isdigit() else c.lower() for c in re.split(r"(\d+)", str(p))])

    tracks: List[LocalTrack] = []
    for p in audio_files:
        disc, track = detect_disc_track(p)
        lt = LocalTrack(p, disc, track)
        lt.title_hint = clean_track_title_hint(p.stem)

        try:
            mf = mutagen.File(str(p), easy=True)
            if mf:
                if "title" in mf and mf["title"]:
                    lt.existing_title = mf["title"][0]
                if "artist" in mf and mf["artist"]:
                    lt.existing_artist = mf["artist"][0]
                if lt.track_num is None and "tracknumber" in mf and mf["tracknumber"]:
                    t_str = mf["tracknumber"][0].split("/")[0]
                    if t_str.isdigit():
                        lt.track_num = int(t_str)
                if lt.disc_num is None and "discnumber" in mf and mf["discnumber"]:
                    d_str = mf["discnumber"][0].split("/")[0]
                    if d_str.isdigit():
                        lt.disc_num = int(d_str)
        except Exception:
            pass

        tracks.append(lt)

    has_disc = any(t.disc_num is not None for t in tracks)
    if not has_disc:
        for t in tracks:
            t.disc_num = 1

    return tracks

def detect_disc_track(file_path: Path) -> Tuple[Optional[int], Optional[int]]:
    disc: Optional[int] = None
    track: Optional[int] = None

    parent_name = file_path.parent.name
    m_dir = re.search(r"(?:disc|cd|disk)\s*(\d+)", parent_name, re.IGNORECASE)
    if m_dir:
        disc = int(m_dir.group(1))

    base = file_path.stem

    m_dt = re.match(r"^(\d{1,2})[.\-_](\d{1,3})(?:[.\s\-_]|$)", base)
    if m_dt:
        disc = int(m_dt.group(1))
        track = int(m_dt.group(2))
        return disc, track

    m_t = re.match(r"^(\d{1,3})(?:[.\s\-_]|$)", base)
    if m_t:
        track = int(m_t.group(1))
        return disc, track

    return disc, track

# -----------------------------------------------------------------------------
# MusicBrainz Search & Scoring
# -----------------------------------------------------------------------------
def escape_lucene(s: str) -> str:
    return re.sub(r'([+\-&|!(){}\[\]^"~*?:\\\/])', r"\\\1", s.strip())

class CandidateMatch:
    def __init__(self, release_dict: Dict[str, Any], score: float, reasons: List[str]):
        self.data = release_dict
        self.id = release_dict.get("id", "")
        self.title = release_dict.get("title", "")
        self.score = score
        self.reasons = reasons
        self.track_count = release_dict.get("track-count", 0)
        self.date = release_dict.get("date", "Unknown")
        self.year = self.date[:4] if self.date and self.date != "Unknown" else "Unkn"
        self.country = release_dict.get("country", "")
        self.status = release_dict.get("status", "")
        self.artist = ""
        artist_credits = release_dict.get("artist-credit", [])
        if artist_credits:
            self.artist = "".join(ac.get("name", "") + ac.get("joinphrase", "") for ac in artist_credits)
        self.labels = []
        for li in release_dict.get("label-info", []):
            cat = li.get("catalog-number")
            lbl = li.get("label", {}).get("name") if li.get("label") else None
            if lbl and cat:
                self.labels.append(f"{lbl} ({cat})")
            elif cat:
                self.labels.append(cat)
            elif lbl:
                self.labels.append(lbl)

def search_and_rank_candidates(
    client: MusicBrainzClient,
    folder_info: FolderInfo,
    local_tracks: List[LocalTrack],
    override_query: Optional[str] = None
) -> List[CandidateMatch]:
    raw_releases: Dict[str, Dict[str, Any]] = {}

    queries = []
    if override_query:
        queries.append(override_query)
    else:
        album_esc = escape_lucene(folder_info.album_hint)
        if folder_info.artist_hint:
            artist_esc = escape_lucene(folder_info.artist_hint)
            queries.append(f'release:"{album_esc}" AND (artist:"{artist_esc}" OR label:"{artist_esc}")')
            queries.append(f'release:"{album_esc}" AND artist:"{artist_esc}"')
        queries.append(f'release:"{album_esc}"')
        queries.append(f'"{album_esc}"')

    for q in queries:
        rels = client.search_releases(q, limit=15)
        for r in rels:
            rid = r.get("id")
            if rid and rid not in raw_releases:
                raw_releases[rid] = r
        if len(raw_releases) >= 8:
            break

    total_local = len(local_tracks)
    candidates: List[CandidateMatch] = []

    for rid, r in raw_releases.items():
        score = 0.0
        reasons = []

        r_tracks = r.get("track-count", 0)
        if r_tracks == total_local and total_local > 0:
            score += 45.0
            reasons.append(f"Exact track count match ({r_tracks})")
        elif r_tracks > 0 and total_local > 0 and abs(r_tracks - total_local) <= 2:
            score += 20.0
            reasons.append(f"Near track count match ({r_tracks} vs {total_local})")

        title = r.get("title", "")
        sim_title = difflib.SequenceMatcher(None, folder_info.album_hint.lower(), title.lower()).ratio()
        score += sim_title * 30.0
        if sim_title > 0.85:
            reasons.append(f"Strong title match ({sim_title*100:.0f}%)")

        r_artist = "".join(ac.get("name", "") for ac in r.get("artist-credit", []))
        if folder_info.artist_hint:
            sim_artist = difflib.SequenceMatcher(None, folder_info.artist_hint.lower(), r_artist.lower()).ratio()
            labels_str = " ".join(li.get("label", {}).get("name", "") for li in r.get("label-info", []) if li.get("label"))
            sim_label = difflib.SequenceMatcher(None, folder_info.artist_hint.lower(), labels_str.lower()).ratio()
            best_prefix_sim = max(sim_artist, sim_label)
            score += best_prefix_sim * 20.0
            if best_prefix_sim > 0.7:
                reasons.append(f"Artist/Label match ({best_prefix_sim*100:.0f}%)")

        r_date = r.get("date", "")
        if folder_info.year_hint and r_date.startswith(folder_info.year_hint):
            score += 15.0
            reasons.append(f"Year matched ({folder_info.year_hint})")

        if r.get("status") == "Official":
            score += 5.0

        candidates.append(CandidateMatch(r, score, reasons))

    candidates.sort(key=lambda c: c.score, reverse=True)
    return candidates

# -----------------------------------------------------------------------------
# Metadata Models
# -----------------------------------------------------------------------------
class ReleaseMetadata:
    def __init__(self, details: Dict[str, Any]):
        self.id = details.get("id", "")
        self.title = details.get("title", "")
        date_raw = details.get("date", "")
        self.year = date_raw[:4] if date_raw else ""
        self.country = details.get("country", "")
        self.barcode = details.get("barcode", "")
        self.disambiguation = details.get("disambiguation", "")

        ac_list = details.get("artist-credit", [])
        self.album_artist = "".join(ac.get("name", "") + ac.get("joinphrase", "") for ac in ac_list)
        self.album_artist_id = ac_list[0].get("artist", {}).get("id", "") if ac_list else ""

        rg = details.get("release-group", {})
        self.release_group_id = rg.get("id", "")

        self.label = ""
        label_info_list = details.get("label-info", [])
        for li in label_info_list:
            if li.get("label") and not self.label:
                self.label = li["label"].get("name", "")

        self.media: List[Dict[str, Any]] = details.get("media", [])
        self.disc_total = len(self.media)

        # Resolve distinct catalog number per disc
        self.catalog_numbers_by_disc = resolve_catalog_numbers(label_info_list, self.disc_total)

        self.tracks_by_disc_track: Dict[Tuple[int, int], Dict[str, Any]] = {}
        self.flat_tracks: List[Dict[str, Any]] = []

        cumulative_idx = 1
        for med in self.media:
            disc_num = med.get("position", 1)
            med_format = med.get("format", "")
            t_count = med.get("track-count", len(med.get("tracks", [])))
            disc_cat = self.catalog_numbers_by_disc.get(disc_num, "")

            for tr in med.get("tracks", []):
                t_pos = tr.get("position", 1)
                t_artist_list = tr.get("artist-credit", [])
                t_artist = "".join(ac.get("name", "") + ac.get("joinphrase", "") for ac in t_artist_list)
                t_artist_id = t_artist_list[0].get("artist", {}).get("id", "") if t_artist_list else ""
                rec = tr.get("recording", {})
                rec_id = rec.get("id", "")

                tr_info = {
                    "disc": disc_num,
                    "disctotal": self.disc_total,
                    "track": t_pos,
                    "tracktotal": t_count,
                    "title": tr.get("title", ""),
                    "artist": t_artist or self.album_artist,
                    "artist_id": t_artist_id,
                    "track_id": tr.get("id", ""),
                    "recording_id": rec_id,
                    "media_format": med_format,
                    "cumulative_idx": cumulative_idx,
                    "catalognumber": disc_cat
                }
                self.tracks_by_disc_track[(disc_num, t_pos)] = tr_info
                self.flat_tracks.append(tr_info)
                cumulative_idx += 1

# -----------------------------------------------------------------------------
# Intelligent Track Alignment
# -----------------------------------------------------------------------------
class TrackAssignment:
    def __init__(self, local_file: Path, meta: Dict[str, Any], match_type: str):
        self.local_file = local_file
        self.meta = meta
        self.match_type = match_type

def align_tracks(local_tracks: List[LocalTrack], release_meta: ReleaseMetadata) -> List[TrackAssignment]:
    assignments: List[TrackAssignment] = []
    unassigned_local = list(local_tracks)
    assigned_meta_keys = set()

    # Pass 1: Check (disc, track) number with title verification
    remaining_local: List[LocalTrack] = []
    for lt in unassigned_local:
        title_for_sim = lt.existing_title or lt.title_hint
        if lt.disc_num is not None and lt.track_num is not None:
            key = (lt.disc_num, lt.track_num)
            if key in release_meta.tracks_by_disc_track and key not in assigned_meta_keys:
                cand_meta = release_meta.tracks_by_disc_track[key]
                sim = difflib.SequenceMatcher(None, title_for_sim.lower(), cand_meta["title"].lower()).ratio() if title_for_sim else 1.0

                if sim >= 0.35 or not title_for_sim:
                    assignments.append(TrackAssignment(lt.file_path, cand_meta, "Exact (disc, track)"))
                    assigned_meta_keys.add(key)
                    continue
                else:
                    best_other_sim = 0.0
                    best_other_meta = None
                    for m in release_meta.flat_tracks:
                        m_key = (m["disc"], m["track"])
                        if m_key in assigned_meta_keys:
                            continue
                        s = difflib.SequenceMatcher(None, title_for_sim.lower(), m["title"].lower()).ratio()
                        if s > best_other_sim:
                            best_other_sim = s
                            best_other_meta = m
                    if best_other_sim >= 0.80 and best_other_meta is not None:
                        m_key = (best_other_meta["disc"], best_other_meta["track"])
                        assignments.append(TrackAssignment(lt.file_path, best_other_meta, f"Title override ({best_other_sim*100:.0f}%)"))
                        assigned_meta_keys.add(m_key)
                        continue
                    else:
                        assignments.append(TrackAssignment(lt.file_path, cand_meta, "Number match"))
                        assigned_meta_keys.add(key)
                        continue

        remaining_local.append(lt)

    # Pass 2: Cumulative track number / Disc 1 single disc
    pass2_remaining: List[LocalTrack] = []
    for lt in remaining_local:
        if lt.track_num is not None:
            key = (1, lt.track_num)
            if key in release_meta.tracks_by_disc_track and key not in assigned_meta_keys:
                assignments.append(TrackAssignment(lt.file_path, release_meta.tracks_by_disc_track[key], "Track number (Disc 1)"))
                assigned_meta_keys.add(key)
                continue
            for m in release_meta.flat_tracks:
                m_key = (m["disc"], m["track"])
                if m["cumulative_idx"] == lt.track_num and m_key not in assigned_meta_keys:
                    assignments.append(TrackAssignment(lt.file_path, m, f"Cumulative track ({lt.track_num})"))
                    assigned_meta_keys.add(m_key)
                    break
            else:
                pass2_remaining.append(lt)
        else:
            pass2_remaining.append(lt)

    # Pass 3: Fuzzy title match against remaining unassigned tracks
    pass3_remaining: List[LocalTrack] = []
    for lt in pass2_remaining:
        title_to_match = lt.existing_title or lt.title_hint or lt.file_path.stem
        best_sim = 0.0
        best_meta = None
        for m in release_meta.flat_tracks:
            m_key = (m["disc"], m["track"])
            if m_key in assigned_meta_keys:
                continue
            sim = difflib.SequenceMatcher(None, title_to_match.lower(), m["title"].lower()).ratio()
            if sim > best_sim:
                best_sim = sim
                best_meta = m
        if best_sim > 0.60 and best_meta is not None:
            m_key = (best_meta["disc"], best_meta["track"])
            assignments.append(TrackAssignment(lt.file_path, best_meta, f"Title similarity ({best_sim*100:.0f}%)"))
            assigned_meta_keys.add(m_key)
        else:
            pass3_remaining.append(lt)

    # Pass 4: Sequential fallback if 1:1 remaining
    unassigned_metas = [m for m in release_meta.flat_tracks if (m["disc"], m["track"]) not in assigned_meta_keys]
    if len(pass3_remaining) == len(unassigned_metas):
        for lt, m in zip(pass3_remaining, unassigned_metas):
            assignments.append(TrackAssignment(lt.file_path, m, "Sequential fallback"))
    elif pass3_remaining:
        for lt in pass3_remaining:
            UI.warn(f"Could not reliably match track for: {lt.file_path.name}")

    assignments.sort(key=lambda a: (a.meta["disc"], a.meta["track"]))
    return assignments

# -----------------------------------------------------------------------------
# Tag Writing & Renaming Engine (Mutagen)
# -----------------------------------------------------------------------------
def apply_tags_and_rename(
    assignment: TrackAssignment,
    release: ReleaseMetadata,
    cover_data: Optional[Tuple[bytes, str]] = None,
    dry_run: bool = False
) -> Tuple[bool, str]:
    target_filename = get_target_filename(assignment, release)
    if dry_run:
        return True, target_filename

    file_path = assignment.local_file
    meta = assignment.meta
    ext = file_path.suffix.lower()

    title = meta["title"]
    artist = meta["artist"]
    album = release.title
    albumartist = release.album_artist or artist
    track = meta["track"]
    tracktotal = meta["tracktotal"]
    disc = meta["disc"]
    disctotal = meta["disctotal"]
    year_val = release.year  # Always only year
    label_val = release.label
    cat_val = meta.get("catalognumber") or release.catalog_numbers_by_disc.get(disc, "")
    media_val = meta.get("media_format") or ""
    comment_val = release.disambiguation

    # Formatting requirements:
    # 1. Track number must always be zero-padded: e.g. "01", "02", "12"
    track_str = f"{track:02d}"
    # 2. Disc number must NOT be zero-padded: e.g. "1", "2", "10"
    disc_str = f"{disc}"
    tracktotal_str = str(tracktotal)
    disctotal_str = str(disctotal)

    try:
        if ext == ".flac":
            audio = FLAC(str(file_path))
            # Remove ALL other existing tags and pictures
            audio.clear()
            audio.clear_pictures()

            # Strictly uppercase tag names
            audio["ALBUM"] = [album]
            audio["ALBUMARTIST"] = [albumartist]
            audio["ARTIST"] = [artist]
            if cat_val:
                audio["CATALOGNUMBER"] = [cat_val]
            if comment_val:
                audio["COMMENT"] = [comment_val]
            audio["DISCNUMBER"] = [disc_str]
            audio["DISCTOTAL"] = [disctotal_str]
            if label_val:
                audio["LABEL"] = [label_val]
            if media_val:
                audio["MEDIA"] = [media_val]
            audio["TITLE"] = [title]
            audio["TRACKNUMBER"] = [track_str]
            audio["TRACKTOTAL"] = [tracktotal_str]
            if year_val:
                audio["YEAR"] = [year_val]

            if cover_data:
                img_bytes, mime = cover_data
                pic = Picture()
                pic.type = 3  # Front cover
                pic.mime = "image/jpeg"
                pic.desc = "Front Cover"
                pic.data = img_bytes
                audio.add_picture(pic)

            audio.save()

        elif ext == ".mp3":
            try:
                id3 = ID3(str(file_path))
                id3.clear()
            except ID3NoHeaderError:
                id3 = ID3()

            id3.add(TIT2(encoding=3, text=title))
            id3.add(TPE1(encoding=3, text=artist))
            id3.add(TALB(encoding=3, text=album))
            id3.add(TPE2(encoding=3, text=albumartist))
            id3.add(TRCK(encoding=3, text=f"{track_str}/{tracktotal_str}"))
            id3.add(TPOS(encoding=3, text=f"{disc_str}/{disctotal_str}"))
            if year_val:
                id3.add(TDRC(encoding=3, text=year_val))
                id3.add(TYER(encoding=3, text=year_val))
            if label_val:
                id3.add(TPUB(encoding=3, text=label_val))
            if cat_val:
                id3.add(TXXX(encoding=3, desc="CATALOGNUMBER", text=cat_val))
            if media_val:
                id3.add(TMED(encoding=3, text=media_val))
            if comment_val:
                id3.add(COMM(encoding=3, lang="eng", desc="", text=comment_val))

            if cover_data:
                img_bytes, mime = cover_data
                id3.add(APIC(encoding=3, mime="image/jpeg", type=3, desc="Front Cover", data=img_bytes))

            id3.save(str(file_path))

        elif ext in (".m4a", ".mp4"):
            mp4 = MP4(str(file_path))
            mp4.clear()
            mp4["\xa9nam"] = [title]
            mp4["\xa9ART"] = [artist]
            mp4["\xa9alb"] = [album]
            mp4["aART"] = [albumartist]
            mp4["trkn"] = [(track, tracktotal)]
            mp4["disk"] = [(disc, disctotal)]
            if year_val:
                mp4["\xa9day"] = [year_val]
            if comment_val:
                mp4["\xa9cmt"] = [comment_val]
            if label_val:
                mp4["----:com.apple.itunes:LABEL"] = label_val.encode("utf-8")
            if cat_val:
                mp4["----:com.apple.itunes:CATALOGNUMBER"] = cat_val.encode("utf-8")
            if media_val:
                mp4["----:com.apple.itunes:MEDIA"] = media_val.encode("utf-8")

            if cover_data:
                img_bytes, mime = cover_data
                mp4["covr"] = [MP4Cover(img_bytes, imageformat=MP4Cover.FORMAT_JPEG)]

            mp4.save()

        elif ext in (".ogg", ".opus"):
            audio = OggVorbis(str(file_path)) if ext == ".ogg" else OggOpus(str(file_path))
            audio.clear()
            audio["ALBUM"] = [album]
            audio["ALBUMARTIST"] = [albumartist]
            audio["ARTIST"] = [artist]
            if cat_val:
                audio["CATALOGNUMBER"] = [cat_val]
            if comment_val:
                audio["COMMENT"] = [comment_val]
            audio["DISCNUMBER"] = [disc_str]
            audio["DISCTOTAL"] = [disctotal_str]
            if label_val:
                audio["LABEL"] = [label_val]
            if media_val:
                audio["MEDIA"] = [media_val]
            audio["TITLE"] = [title]
            audio["TRACKNUMBER"] = [track_str]
            audio["TRACKTOTAL"] = [tracktotal_str]
            if year_val:
                audio["YEAR"] = [year_val]

            if cover_data:
                import base64
                img_bytes, mime = cover_data
                pic = Picture()
                pic.type = 3
                pic.mime = "image/jpeg"
                pic.desc = "Front Cover"
                pic.data = img_bytes
                b64 = base64.b64encode(pic.write()).decode("ascii")
                audio["METADATA_BLOCK_PICTURE"] = [b64]

            audio.save()

        else:
            mf = mutagen.File(str(file_path), easy=True)
            if mf is not None:
                mf.clear()
                mf["title"] = [title]
                mf["artist"] = [artist]
                mf["album"] = [album]
                mf["albumartist"] = [albumartist]
                mf["tracknumber"] = [f"{track_str}/{tracktotal_str}"]
                mf["discnumber"] = [f"{disc_str}/{disctotal_str}"]
                if year_val:
                    mf["year"] = [year_val]
                mf.save()

        # Rename file on disk to standardized format
        target_path = file_path.parent / target_filename
        if target_path != file_path:
            if target_path.exists():
                if target_path.resolve() == file_path.resolve():
                    tmp_path = file_path.with_name(f"__rename_tmp_{int(time.time())}_{file_path.name}")
                    file_path.rename(tmp_path)
                    tmp_path.rename(target_path)
                else:
                    target_path.unlink()
                    file_path.rename(target_path)
            else:
                file_path.rename(target_path)
            assignment.local_file = target_path

        return True, target_filename

    except Exception as e:
        UI.error(f"Error tagging/renaming {file_path.name}: {e}")
        return False, file_path.name

# -----------------------------------------------------------------------------
# Main CLI Workflow
# -----------------------------------------------------------------------------
def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="mp3tag",
        description="Download correct Picard / MusicBrainz metadata, write tags, and rename music files based on folder name.",
        epilog="Examples:\n  mp3tag 'KONAMI - SOUND VOLTEX ULTIMATE TRACKS'\n  mp3tag /path/to/album -y\n  mp3tag . --cover",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("folder", nargs="+", help="Directory containing the album or audio files")
    parser.add_argument("-y", "--yes", action="store_true", help="Non-interactive mode (auto-select top match & apply)")
    parser.add_argument("-n", "--dry-run", action="store_true", help="Preview tags and changes without writing to disk")
    parser.add_argument("--cover", action="store_true", help="Download and embed front cover art (and save albumart.jpg). Default: disabled")
    parser.add_argument("-q", "--query", help="Override search query instead of using the folder name")
    parser.add_argument("--id", help="MusicBrainz Release ID (UUID) or URL to fetch directly")
    parser.add_argument("-v", "--verbose", action="store_true", help="Enable verbose debug output")
    return parser.parse_args()

def resolve_target_dir(folder_tokens: List[str]) -> Path:
    combined = " ".join(folder_tokens)
    p = Path(combined).expanduser().resolve()
    if p.exists() and p.is_dir():
        return p

    first_p = Path(folder_tokens[0]).expanduser().resolve()
    if first_p.exists() and first_p.is_dir():
        return first_p

    return p

def main():
    args = parse_arguments()
    UI.banner()

    target_dir = resolve_target_dir(args.folder)
    if not target_dir.exists():
        UI.error(f"Directory not found: {target_dir}")
        sys.exit(1)
    if not target_dir.is_dir():
        UI.error(f"Path is not a directory: {target_dir}")
        sys.exit(1)

    # 1. Scan local files
    UI.header(f"Scanning Directory: {target_dir.name}")
    local_tracks = scan_audio_files(target_dir)
    if not local_tracks:
        UI.error(f"No audio files found in: {target_dir}")
        sys.exit(1)

    discs_found = len(set(t.disc_num for t in local_tracks if t.disc_num is not None))
    UI.info(f"Found {UI.BOLD}{len(local_tracks)}{UI.RESET} audio files across {UI.BOLD}{max(1, discs_found)}{UI.RESET} disc(s).")

    # 2. Parse folder information
    folder_info = FolderInfo(target_dir)
    if folder_info.artist_hint:
        UI.info(f"Parsed Folder: Artist='{UI.BOLD}{folder_info.artist_hint}{UI.RESET}', Album='{UI.BOLD}{folder_info.album_hint}{UI.RESET}'")
    else:
        UI.info(f"Parsed Folder: Album='{UI.BOLD}{folder_info.album_hint}{UI.RESET}'")

    # 3. Query MusicBrainz
    client = MusicBrainzClient()
    chosen_release_id: Optional[str] = None

    if args.id:
        m = re.search(r"([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})", args.id, re.IGNORECASE)
        if m:
            chosen_release_id = m.group(1)
            UI.info(f"Using direct Release ID: {chosen_release_id}")
        else:
            UI.error(f"Invalid MusicBrainz ID/URL format: {args.id}")
            sys.exit(1)

    current_query = args.query

    while not chosen_release_id:
        UI.header("Searching MusicBrainz (Picard Database)...")
        candidates = search_and_rank_candidates(client, folder_info, local_tracks, override_query=current_query)

        if not candidates:
            UI.warn("No matching releases found.")
            if not sys.stdin.isatty() or args.yes:
                sys.exit(1)
            prompt = input(f"{UI.YELLOW}Enter a manual search query (or 'q' to quit): {UI.RESET}").strip()
            if not prompt or prompt.lower() == 'q':
                sys.exit(0)
            current_query = prompt
            continue

        print(f"\n{UI.BOLD}{'#':<3} {'Score':<6} {'Title':<35} {'Artist':<22} {'Year':<6} {'Tracks':<8} {'Catalog#'}{UI.RESET}")
        print("─" * 92)
        top_candidates = candidates[:6]
        for idx, c in enumerate(top_candidates, 1):
            score_color = UI.GREEN if c.score >= 70 else (UI.YELLOW if c.score >= 40 else UI.WHITE)
            cat_info = c.labels[0] if c.labels else ""
            title_display = (c.title[:32] + "...") if len(c.title) > 35 else c.title
            artist_display = (c.artist[:20] + "...") if len(c.artist) > 22 else c.artist
            cat_display = (cat_info[:16] + "...") if len(cat_info) > 18 else cat_info
            print(f"{UI.BOLD}[{idx}]{UI.RESET} {score_color}{c.score:>4.0f}%{UI.RESET} {title_display:<35} {artist_display:<22} {c.year:<6} {c.track_count:<8} {cat_display}")

        if args.yes or not sys.stdin.isatty():
            best = top_candidates[0]
            UI.success(f"Auto-selected top match: {best.title} by {best.artist} ({best.year})")
            chosen_release_id = best.id
            break

        # Interactive prompt
        print()
        prompt_text = f"{UI.CYAN}Select release [1-{len(top_candidates)}] (Enter=1), [m]anual query, [u]RL/ID, [q]uit: {UI.RESET}"
        user_choice = input(prompt_text).strip().lower()

        if user_choice == "" or user_choice == "1":
            chosen_release_id = top_candidates[0].id
            break
        elif user_choice in [str(i) for i in range(1, len(top_candidates) + 1)]:
            chosen_release_id = top_candidates[int(user_choice) - 1].id
            break
        elif user_choice == "m":
            m_query = input(f"{UI.CYAN}Search query: {UI.RESET}").strip()
            if m_query:
                current_query = m_query
            continue
        elif user_choice == "u":
            u_input = input(f"{UI.CYAN}MusicBrainz URL or MBID: {UI.RESET}").strip()
            m = re.search(r"([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})", u_input, re.IGNORECASE)
            if m:
                chosen_release_id = m.group(1)
                break
            else:
                UI.error("Invalid UUID / URL.")
                continue
        elif user_choice == "q":
            UI.info("Aborted by user.")
            sys.exit(0)
        else:
            UI.warn("Invalid selection.")

    # 4. Fetch full release details
    UI.header("Fetching Full Release Metadata...")
    details = client.get_release_details(chosen_release_id)
    if not details:
        UI.error(f"Failed to fetch details for release: {chosen_release_id}")
        sys.exit(1)

    release_meta = ReleaseMetadata(details)
    UI.success(f"Release: {UI.BOLD}{release_meta.title}{UI.RESET} by {UI.BOLD}{release_meta.album_artist}{UI.RESET}")
    cats_summary = ", ".join(f"Disc {d}: {c}" for d, c in release_meta.catalog_numbers_by_disc.items() if c)
    UI.info(f"Year: {release_meta.year or 'Unknown'} | Label: {release_meta.label or 'None'} | Catalog#: {cats_summary or 'None'}")
    UI.info(f"Media: {release_meta.disc_total} disc(s), {len(release_meta.flat_tracks)} total tracks.")

    # 5. Fetch Cover Art (Only if --cover is specified)
    cover_data: Optional[Tuple[bytes, str]] = None
    if args.cover:
        UI.step("Fetching front cover art from Cover Art Archive...")
        raw_cover = client.fetch_cover_art(release_meta.id, release_meta.release_group_id)
        if raw_cover:
            img_bytes, _ = raw_cover
            jpeg_bytes = ensure_jpeg(img_bytes)
            cover_data = (jpeg_bytes, "image/jpeg")
            UI.success(f"Cover Art downloaded & verified as JPEG ({len(jpeg_bytes) // 1024} KB)")
            if not args.dry_run:
                albumart_dest = target_dir / "albumart.jpg"
                try:
                    albumart_dest.write_bytes(jpeg_bytes)
                    UI.info(f"Saved cover art to: {albumart_dest.name}")
                except Exception as e:
                    UI.warn(f"Could not save albumart.jpg: {e}")
        else:
            UI.warn("No cover art available in Cover Art Archive.")

    # 6. Align local files to release tracks
    UI.header("Aligning Tracks & Generating Filenames...")
    assignments = align_tracks(local_tracks, release_meta)

    print(f"\n{UI.BOLD}{'Disc.Trk':<10} {'Current Filename':<30} {'New Filename':<40} {'Catalog#'}{UI.RESET}")
    print("─" * 96)
    for a in assignments:
        d_t = f"{a.meta['disc']}.{a.meta['track']:02d}"
        fn = (a.local_file.name[:27] + "...") if len(a.local_file.name) > 30 else a.local_file.name
        new_name = get_target_filename(a, release_meta)
        new_name_disp = (new_name[:37] + "...") if len(new_name) > 40 else new_name
        cat_disp = a.meta.get("catalognumber", "")
        print(f"{UI.CYAN}{d_t:<10}{UI.RESET} {fn:<30} {UI.BOLD}{new_name_disp:<40}{UI.RESET} {cat_disp}")

    if not assignments:
        UI.error("No tracks could be aligned. Exiting.")
        sys.exit(1)

    # 7. Confirmation (if interactive & not yes/dry-run)
    if not args.dry_run and not args.yes and sys.stdin.isatty():
        print()
        ans = input(f"{UI.BOLD}{UI.YELLOW}Apply tags & rename {len(assignments)} file(s)? [Y/n]: {UI.RESET}").strip().lower()
        if ans not in ("", "y", "yes"):
            UI.info("Aborted by user.")
            sys.exit(0)

    # 8. Apply Tags & Rename
    if args.dry_run:
        UI.header("DRY RUN COMPLETED")
        UI.success(f"Simulated tagging and renaming for {len(assignments)} files. No files were modified.")
        sys.exit(0)

    UI.header(f"Writing Tags and Renaming {len(assignments)} Audio Files...")
    success_count = 0
    for a in assignments:
        old_name = a.local_file.name
        ok, new_name = apply_tags_and_rename(a, release_meta, cover_data=cover_data, dry_run=args.dry_run)
        if ok:
            success_count += 1
            if old_name != new_name:
                print(f"  {UI.GREEN}✔{UI.RESET} [{a.meta['disc']}.{a.meta['track']:02d}] {old_name} -> {UI.BOLD}{new_name}{UI.RESET}")
            else:
                print(f"  {UI.GREEN}✔{UI.RESET} [{a.meta['disc']}.{a.meta['track']:02d}] {new_name}")
        else:
            print(f"  {UI.RED}✖{UI.RESET} Failed: {old_name}")

    print()
    if success_count == len(assignments):
        UI.success(f"All {success_count} files successfully tagged and renamed!")
    else:
        UI.warn(f"Processed {success_count} / {len(assignments)} files.")

if __name__ == "__main__":
    main()
