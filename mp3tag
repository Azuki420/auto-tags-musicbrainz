# Main CLI Workflow
# -----------------------------------------------------------------------------
def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="mp3tag",
        description="Download correct Picard / MusicBrainz metadata, write tags, and rename music files based on folder name.",
        epilog="Examples:\n  mp3tag 'KONAMI - SOUND VOLTEX ULTIMATE TRACKS'\n  mp3tag /path/to/album -y\n  mp3tag . --cover",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("folder", nargs="+", help="Directory containing the album or audio files")
    parser.add_argument("-y", "--yes", action="store_true", help="Non-interactive mode (auto-select top match & apply)")
    parser.add_argument("-n", "--dry-run", action="store_true", help="Preview tags and changes without writing to disk")
    parser.add_argument("--cover", action="store_true", help="Download and embed front cover art (and save albumart.jpg). Default: disabled")
    parser.add_argument("-q", "--query", help="Override search query instead of using the folder name")
    parser.add_argument("--id", help="MusicBrainz Release ID (UUID) or URL to fetch directly")
    parser.add_argument("-v", "--verbose", action="store_true", help="Enable verbose debug output")
    return parser.parse_args()

def resolve_target_dir(folder_tokens: List[str]) -> Path:
    combined = " ".join(folder_tokens)
    p = Path(combined).expanduser().resolve()
    if p.exists() and p.is_dir():
        return p

    first_p = Path(folder_tokens[0]).expanduser().resolve()
    if first_p.exists() and first_p.is_dir():
        return first_p

    return p

def main():
    args = parse_arguments()
    UI.banner()

    target_dir = resolve_target_dir(args.folder)
    if not target_dir.exists():
        UI.error(f"Directory not found: {target_dir}")
        sys.exit(1)
    if not target_dir.is_dir():
        UI.error(f"Path is not a directory: {target_dir}")
        sys.exit(1)

    # 1. Scan local files
    UI.header(f"Scanning Directory: {target_dir.name}")
    local_tracks = scan_audio_files(target_dir)
    if not local_tracks:
        UI.error(f"No audio files found in: {target_dir}")
        sys.exit(1)

    discs_found = len(set(t.disc_num for t in local_tracks if t.disc_num is not None))
    UI.info(f"Found {UI.BOLD}{len(local_tracks)}{UI.RESET} audio files across {UI.BOLD}{max(1, discs_found)}{UI.RESET} disc(s).")

    # 2. Parse folder information
    folder_info = FolderInfo(target_dir)
    if folder_info.artist_hint:
        UI.info(f"Parsed Folder: Artist='{UI.BOLD}{folder_info.artist_hint}{UI.RESET}', Album='{UI.BOLD}{folder_info.album_hint}{UI.RESET}'")
    else:
        UI.info(f"Parsed Folder: Album='{UI.BOLD}{folder_info.album_hint}{UI.RESET}'")

    # 3. Query MusicBrainz
    client = MusicBrainzClient()
    chosen_release_id: Optional[str] = None

    if args.id:
        resolved = resolve_release_id(client, args.id, local_tracks, interactive=not args.yes and sys.stdin.isatty())
        if resolved:
            chosen_release_id = resolved
        else:
            UI.error(f"Could not resolve Release from: {args.id}")
            sys.exit(1)

    current_query = args.query

    while not chosen_release_id:
        UI.header("Searching MusicBrainz (Picard Database)...")
        candidates = search_and_rank_candidates(client, folder_info, local_tracks, override_query=current_query)

        if not candidates:
            UI.warn("No matching releases found.")
            if args.yes:
                sys.exit(1)
            try:
                prompt = input(f"{UI.YELLOW}Enter a manual search query, URL, or MBID (or 'q' to quit): {UI.RESET}").strip()
            except (EOFError, KeyboardInterrupt):
                sys.exit(1)
            if not prompt or prompt.lower() == 'q':
                sys.exit(0)
            resolved = resolve_release_id(client, prompt, local_tracks, interactive=True)
            if resolved:
                chosen_release_id = resolved
                break
            current_query = prompt
            continue

        print(f"\n{UI.BOLD}{'#':<3} {'Score':<6} {'Title':<35} {'Artist':<22} {'Year':<6} {'Tracks':<8} {'Catalog#'}{UI.RESET}")
        print("─" * 92)
        top_candidates = candidates[:6]
        for idx, c in enumerate(top_candidates, 1):
            score_color = UI.GREEN if c.score >= 70 else (UI.YELLOW if c.score >= 40 else UI.WHITE)
            cat_info = c.labels[0] if c.labels else ""
            title_display = (c.title[:32] + "...") if len(c.title) > 35 else c.title
            artist_display = (c.artist[:20] + "...") if len(c.artist) > 22 else c.artist
            cat_display = (cat_info[:16] + "...") if len(cat_info) > 18 else cat_info
            print(f"{UI.BOLD}[{idx}]{UI.RESET} {score_color}{c.score:>4.0f}%{UI.RESET} {title_display:<35} {artist_display:<22} {c.year:<6} {c.track_count:<8} {cat_display}")

        if args.yes:
            best = top_candidates[0]
            UI.success(f"Auto-selected top match: {best.title} by {best.artist} ({best.year})")
            chosen_release_id = best.id
            break

        # Interactive prompt
        print()
        prompt_text = f"{UI.CYAN}Select release [1-{len(top_candidates)}] (Enter=1), [m]anual query, [u]RL/ID, [q]uit: {UI.RESET}"
        try:
            user_choice = input(prompt_text).strip().lower()
        except (EOFError, KeyboardInterrupt):
            best = top_candidates[0]
            UI.success(f"Auto-selected top match: {best.title} by {best.artist} ({best.year})")
            chosen_release_id = best.id
            break

        if user_choice == "" or user_choice == "1":
            chosen_release_id = top_candidates[0].id
            break
        elif user_choice in [str(i) for i in range(1, len(top_candidates) + 1)]:
            chosen_release_id = top_candidates[int(user_choice) - 1].id
            break
        elif user_choice == "m":
            m_query = input(f"{UI.CYAN}Search query, URL or MBID: {UI.RESET}").strip()
            if m_query:
                resolved = resolve_release_id(client, m_query, local_tracks, interactive=True)
                if resolved:
                    chosen_release_id = resolved
                    break
                current_query = m_query
            continue
        elif user_choice == "u":
            u_input = input(f"{UI.CYAN}MusicBrainz URL or MBID: {UI.RESET}").strip()
            resolved = resolve_release_id(client, u_input, local_tracks, interactive=True)
            if resolved:
                chosen_release_id = resolved
                break
            else:
                UI.error("Invalid UUID or URL.")
                continue
        elif user_choice == "q":
            UI.info("Aborted by user.")
            sys.exit(0)
        else:
            UI.warn("Invalid selection.")

    # 4. Fetch full release details
    UI.header("Fetching Full Release Metadata...")
    details = client.get_release_details(chosen_release_id)
    if not details:
        UI.error(f"Failed to fetch details for release: {chosen_release_id}")
        sys.exit(1)

    release_meta = ReleaseMetadata(details)
    UI.success(f"Release: {UI.BOLD}{release_meta.title}{UI.RESET} by {UI.BOLD}{release_meta.album_artist}{UI.RESET}")
    cats_summary = ", ".join(f"Disc {d}: {c}" for d, c in release_meta.catalog_numbers_by_disc.items() if c)
    UI.info(f"Year: {release_meta.year or 'Unknown'} | Label: {release_meta.label or 'None'} | Catalog#: {cats_summary or 'None'}")
    detected_media = detect_media_format(target_dir, local_tracks)
    media_display = f"{UI.BOLD}{detected_media}{UI.RESET}" if detected_media else "(Empty / None)"
    UI.info(f"Discs: {release_meta.disc_total} disc(s), {len(release_meta.flat_tracks)} total tracks | MEDIA: {media_display}")

    # 5. Cover Art Discovery & Preparation
    # Search folder for already existing album art or cover (regardless of filename)
    local_cover = find_local_cover_art(target_dir)
    cover_data: Optional[Tuple[bytes, str]] = None
    cover_action_plan: Optional[str] = None
    final_cover_bytes: Optional[bytes] = None

    if local_cover:
        final_cover_bytes = local_cover.jpeg_bytes
        if local_cover.needs_rename_or_convert:
            if args.cover:
                cover_data = (final_cover_bytes, "image/jpeg")
                cover_action_plan = f"Convert & rename '{local_cover.source_path.name}' -> albumart.jpg and embed into tags ({len(final_cover_bytes) // 1024} KB JPEG)"
                UI.success(f"Cover Art: Found '{local_cover.source_path.name}' -> will convert & embed into tags ({len(final_cover_bytes) // 1024} KB)")
            else:
                cover_action_plan = f"Convert & rename '{local_cover.source_path.name}' -> albumart.jpg ({len(final_cover_bytes) // 1024} KB JPEG)"
                UI.info(f"Cover Art: Found '{local_cover.source_path.name}' -> will standardize to albumart.jpg (embedding disabled, use --cover to embed)")
        else:
            if args.cover:
                cover_data = (final_cover_bytes, "image/jpeg")
                cover_action_plan = f"Embed existing 'albumart.jpg' into audio tags ({len(final_cover_bytes) // 1024} KB JPEG)"
                UI.success(f"Cover Art: Found valid 'albumart.jpg' -> will embed into tags ({len(final_cover_bytes) // 1024} KB)")
            else:
                cover_action_plan = None
                UI.info(f"Cover Art: Found valid 'albumart.jpg' (no changes needed, use --cover to embed)")

    elif args.cover:
        UI.step("No local cover art found. Fetching front cover art from Cover Art Archive...")
        raw_cover = client.fetch_cover_art(release_meta.id, release_meta.release_group_id)
        if raw_cover:
            img_bytes, _ = raw_cover
            final_cover_bytes = ensure_jpeg(img_bytes)
            cover_data = (final_cover_bytes, "image/jpeg")
            cover_action_plan = f"Download from MusicBrainz -> save as albumart.jpg ({len(final_cover_bytes) // 1024} KB)"
            UI.success(f"Cover Art downloaded & verified as JPEG ({len(final_cover_bytes) // 1024} KB)")
        else:
            UI.warn("No cover art available in folder or in Cover Art Archive.")

    # 6. Align local files to release tracks
    UI.header("Aligning Tracks & Generating Filenames...")
    assignments = align_tracks(local_tracks, release_meta)
    for a in assignments:
        a.meta["media_format"] = detected_media

    print(f"\n{UI.BOLD}{'Disc.Trk':<10} {'Current Filename':<28} {'New Filename':<38} {'Catalog#':<12} {'MEDIA'}{UI.RESET}")
    print("─" * 98)
    for a in assignments:
        d_t = f"{a.meta['disc']}.{a.meta['track']:02d}"
        fn = (a.local_file.name[:25] + "...") if len(a.local_file.name) > 28 else a.local_file.name
        new_name = get_target_filename(a, release_meta)
        new_name_disp = (new_name[:35] + "...") if len(new_name) > 38 else new_name
        cat_disp = (a.meta.get("catalognumber", "")[:10] + "..") if len(a.meta.get("catalognumber", "")) > 12 else a.meta.get("catalognumber", "")
        med_disp = detected_media or "-"
        print(f"{UI.CYAN}{d_t:<10}{UI.RESET} {fn:<28} {UI.BOLD}{new_name_disp:<38}{UI.RESET} {cat_disp:<12} {med_disp}")

    target_folder_name = get_target_foldername(release_meta)
    folder_rename_plan = None
    if target_folder_name and target_folder_name != target_dir.name:
        folder_rename_plan = f"Rename folder: '{target_dir.name}' -> '{target_folder_name}'"

    aux_plan = plan_auxiliary_files(target_dir, target_folder_name, release_meta, discs_found, local_tracks)

    if cover_action_plan:
        print(f"\n{UI.BOLD}Cover Art Action:{UI.RESET} {cover_action_plan}")
    if folder_rename_plan:
        if not cover_action_plan:
            print()
        print(f"{UI.BOLD}Folder Action:{UI.RESET}    {folder_rename_plan}")
    if aux_plan.playlists_to_remove or aux_plan.files_to_rename:
        if not cover_action_plan and not folder_rename_plan:
            print()
        print(f"{UI.BOLD}Auxiliary Files:{UI.RESET}")
        for p in aux_plan.playlists_to_remove:
            print(f"  • Remove playlist: {UI.YELLOW}{p.name}{UI.RESET}")
        for src, dst in aux_plan.files_to_rename:
            print(f"  • Rename:          '{src.name}' -> {UI.BOLD}{dst.name}{UI.RESET}")

    if not assignments:
        UI.error("No tracks could be aligned. Exiting.")
        sys.exit(1)

    # 7. Confirmation (if interactive & not yes/dry-run)
    if not args.dry_run and not args.yes and sys.stdin.isatty():
        print()
        ans = input(f"{UI.BOLD}{UI.YELLOW}Apply tags & rename {len(assignments)} file(s)? [Y/n]: {UI.RESET}").strip().lower()
        if ans not in ("", "y", "yes"):
            UI.info("Aborted by user.")
            sys.exit(0)

    # 8. Apply Tags & Rename
    if args.dry_run:
        UI.header("DRY RUN COMPLETED")
        if cover_action_plan:
            UI.info(f"[Dry Run] {cover_action_plan}")
        if folder_rename_plan:
            UI.info(f"[Dry Run] {folder_rename_plan}")
        for p in aux_plan.playlists_to_remove:
            UI.info(f"[Dry Run] Remove playlist: '{p.name}'")
        for src, dst in aux_plan.files_to_rename:
            UI.info(f"[Dry Run] Rename '{src.name}' -> '{dst.name}'")
        UI.success(f"Simulated tagging and renaming for {len(assignments)} files. No files were modified.")
        sys.exit(0)

    # Standardize cover art on disk
    if final_cover_bytes:
        albumart_dest = target_dir / "albumart.jpg"
        try:
            if local_cover and local_cover.needs_rename_or_convert:
                albumart_dest.write_bytes(final_cover_bytes)
                if local_cover.source_path.resolve() != albumart_dest.resolve():
                    local_cover.source_path.unlink(missing_ok=True)
                for other_f in target_dir.iterdir():
                    if other_f.is_file() and other_f.resolve() != albumart_dest.resolve():
                        if other_f.stem.lower() in ("cover", "folder", "front") and other_f.suffix.lower() in IMAGE_EXTENSIONS:
                            other_f.unlink(missing_ok=True)
                UI.success(f"Standardized cover art to: {albumart_dest.name}")
            elif not local_cover and cover_data:
                albumart_dest.write_bytes(final_cover_bytes)
                UI.success(f"Saved cover art to: {albumart_dest.name}")
        except Exception as e:
            UI.warn(f"Could not save albumart.jpg: {e}")

    UI.header(f"Writing Tags and Renaming {len(assignments)} Audio Files...")
    success_count = 0
    for a in assignments:
        old_name = a.local_file.name
        ok, new_name = apply_tags_and_rename(a, release_meta, cover_data=cover_data, dry_run=args.dry_run)
        if ok:
            success_count += 1
            if old_name != new_name:
                print(f"  {UI.GREEN}✔{UI.RESET} [{a.meta['disc']}.{a.meta['track']:02d}] {old_name} -> {UI.BOLD}{new_name}{UI.RESET}")
            else:
                print(f"  {UI.GREEN}✔{UI.RESET} [{a.meta['disc']}.{a.meta['track']:02d}] {new_name}")
        else:
            print(f"  {UI.RED}✖{UI.RESET} Failed: {old_name}")

    print()
    if success_count == len(assignments):
        UI.success(f"All {success_count} files successfully tagged and renamed!")
    else:
        UI.warn(f"Processed {success_count} / {len(assignments)} files.")

    # 8.2 Auxiliary Files (.m3u8 removal, .cue/.log renaming)
    for p in aux_plan.playlists_to_remove:
        try:
            p.unlink(missing_ok=True)
            UI.success(f"Removed playlist: {p.name}")
        except Exception as e:
            UI.warn(f"Could not remove playlist {p.name}: {e}")

    for src, dst in aux_plan.files_to_rename:
        try:
            if src.exists():
                if dst.exists() and dst.resolve() != src.resolve():
                    dst.unlink(missing_ok=True)
                elif dst.resolve() == src.resolve():
                    tmp_dst = src.with_name(f"__rename_tmp_{int(time.time())}_{src.name}")
                    src.rename(tmp_dst)
                    tmp_dst.rename(dst)
                    if dst.suffix.lower() == ".cue":
                        update_cue_file_references(dst, assignments, release_meta)
                    UI.success(f"Renamed: '{src.name}' -> {UI.BOLD}{dst.name}{UI.RESET}")
                    continue
                src.rename(dst)
                if dst.suffix.lower() == ".cue":
                    update_cue_file_references(dst, assignments, release_meta)
                UI.success(f"Renamed: '{src.name}' -> {UI.BOLD}{dst.name}{UI.RESET}")
        except Exception as e:
            UI.warn(f"Could not rename {src.name} to {dst.name}: {e}")

    # 9. Rename album folder
    if target_folder_name and target_folder_name != target_dir.name:
        new_dir = target_dir.parent / target_folder_name
        try:
            if new_dir.exists():
                if new_dir.resolve() == target_dir.resolve():
                    tmp_dir = target_dir.parent / f"__rename_tmp_{int(time.time())}_{target_folder_name}"
                    target_dir.rename(tmp_dir)
                    tmp_dir.rename(new_dir)
                    UI.success(f"Renamed album folder: '{target_dir.name}' -> {UI.BOLD}{target_folder_name}{UI.RESET}")
                else:
                    UI.warn(f"Cannot rename folder to '{target_folder_name}': destination folder already exists.")
            else:
                target_dir.rename(new_dir)
                UI.success(f"Renamed album folder: '{target_dir.name}' -> {UI.BOLD}{target_folder_name}{UI.RESET}")
        except Exception as e:
            UI.warn(f"Could not rename album folder: {e}")

if __name__ == "__main__":
    main()
