# Media Format Detection
# -----------------------------------------------------------------------------
def detect_media_format(target_dir: Path, local_tracks: List[LocalTrack]) -> str:
    """
    Determines MEDIA tag value based on folder content and folder name:
    - If files are 24-bit FLAC (or folder name indicates 24bit/WEB): 'WEB'
    - If folder contains .cue or .log files (or folder name indicates CD/EAC): 'CD'
    - When none of these: '' (leave empty, omitting the MEDIA tag)
    """
    folder_name_lower = target_dir.name.lower()

    # 1. Check if audio files are 24-bit FLAC
    is_24bit_flac = False
    for lt in local_tracks:
        if lt.file_path.suffix.lower() == ".flac":
            try:
                audio = FLAC(str(lt.file_path))
                if audio.info and getattr(audio.info, "bits_per_sample", 16) >= 24:
                    is_24bit_flac = True
                    break
            except Exception:
                pass

    web_name_match = bool(re.search(
        r"\b(?:24bit|24-bit|24_bit|web|web-dl|webrip|qobuz|tidal|mora|ototoy|bandcamp|hdtracks)\b",
        folder_name_lower
    ))

    if is_24bit_flac or web_name_match:
        return "WEB"

    # 2. Check if folder contains .cue or .log files
    has_cue_or_log = False
    for root, _, files in os.walk(target_dir):
        for f in files:
            ext = os.path.splitext(f)[1].lower()
            if ext in (".cue", ".log"):
                has_cue_or_log = True
                break
        if has_cue_or_log:
            break

    cd_name_match = bool(re.search(r"[\[\(]cd[\]\)]|\beac\b|\bexact audio copy\b", folder_name_lower))

    if has_cue_or_log or cd_name_match:
        return "CD"

    # 3. None of these -> leave empty
    return ""

