def escape_lucene(s: str) -> str:
    return re.sub(r'([+\-&|!(){}\[\]^"~*?:\\\/])', lambda m: '\\\\' + m.group(1), s.strip())

def parse_mb_id_or_url(s: str) -> Optional[Tuple[str, str]]:
    clean = s.strip()
    m = re.search(r"([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})", clean, re.IGNORECASE)
    if not m:
        return None
    uuid = m.group(1).lower()
    if "release-group" in clean:
        return ("release-group", uuid)
    elif "release" in clean:
        return ("release", uuid)
    return ("uuid", uuid)

def select_release_from_group(
    client: MusicBrainzClient,
    releases: List[Dict[str, Any]],
    local_tracks: List[LocalTrack],
    interactive: bool = True
) -> Optional[str]:
    if not releases:
        return None
    if len(releases) == 1:
        chosen = releases[0]
        r_title = chosen.get("title", "")
        r_artist = "".join(ac.get("name", "") for ac in chosen.get("artist-credit", []))
        UI.success(f"Resolved Release Group to release: '{r_title}' by {r_artist} ({chosen.get('id')})")
        return chosen.get("id")

    total_local = len(local_tracks)
    scored_candidates: List[CandidateMatch] = []
    for r in releases:
        score = 50.0
        reasons = ["Release group member"]
        r_tracks = r.get("track-count", 0)
        if r_tracks == total_local and total_local > 0:
            score += 45.0
            reasons.append(f"Exact track count match ({r_tracks})")
        elif r_tracks > 0 and total_local > 0 and abs(r_tracks - total_local) <= 2:
            score += 20.0
            reasons.append(f"Near track count match ({r_tracks} vs {total_local})")
        if r.get("status") == "Official":
            score += 5.0
        scored_candidates.append(CandidateMatch(r, score, reasons))

    scored_candidates.sort(key=lambda c: c.score, reverse=True)

    if not interactive:
        best = scored_candidates[0]
        UI.success(f"Auto-selected release from group: {best.title} ({best.year}) [{best.id}]")
        return best.id

    print(f"\n{UI.BOLD}Releases found in Release Group:{UI.RESET}")
    print(f"{UI.BOLD}{'#':<3} {'Score':<6} {'Title':<35} {'Artist':<22} {'Year':<6} {'Tracks':<8} {'Format/Country'}{UI.RESET}")
    print("─" * 92)
    for idx, c in enumerate(scored_candidates, 1):
        score_color = UI.GREEN if c.score >= 70 else (UI.YELLOW if c.score >= 40 else UI.WHITE)
        title_disp = (c.title[:32] + "...") if len(c.title) > 35 else c.title
        artist_disp = (c.artist[:20] + "...") if len(c.artist) > 22 else c.artist
        fmt_info = c.country or ""
        print(f"{UI.BOLD}[{idx}]{UI.RESET} {score_color}{c.score:>4.0f}%{UI.RESET} {title_disp:<35} {artist_disp:<22} {c.year:<6} {c.track_count:<8} {fmt_info}")

    print()
    choice = input(f"{UI.CYAN}Select release [1-{len(scored_candidates)}] (Enter=1): {UI.RESET}").strip()
    if not choice or choice == "1":
        return scored_candidates[0].id
    if choice.isdigit() and 1 <= int(choice) <= len(scored_candidates):
        return scored_candidates[int(choice) - 1].id

    return scored_candidates[0].id

def resolve_release_id(
    client: MusicBrainzClient,
    input_str: str,
    local_tracks: List[LocalTrack],
    interactive: bool = True
) -> Optional[str]:
    parsed = parse_mb_id_or_url(input_str)
    if not parsed:
        return None

    kind, uuid = parsed

    if kind == "release":
        UI.info(f"Targeting direct Release ID: {uuid}")
        return uuid

    if kind == "release-group":
        UI.step(f"Resolving Release Group: {uuid}...")
        releases = client.get_release_group_releases(uuid)
        if not releases:
            UI.warn(f"No releases found in Release Group: {uuid}")
            return None
        return select_release_from_group(client, releases, local_tracks, interactive=interactive)

    # Kind is 'uuid' - test if it's a release or release-group
    details = client.get_release_details(uuid)
    if details:
        UI.info(f"Targeting direct Release ID: {uuid}")
        return uuid

    releases = client.get_release_group_releases(uuid)
    if releases:
        UI.step(f"MBID identified as Release Group: {uuid}")
        return select_release_from_group(client, releases, local_tracks, interactive=interactive)

    UI.error(f"MBID '{uuid}' not found as Release or Release Group on MusicBrainz.")
    return None

def is_placeholder_label(name: Optional[str]) -> bool:
    """Returns True if the label name is a generic placeholder like [no label], [none], etc."""
    if not name:
        return True
    clean = name.strip().lower()
    clean_inner = re.sub(r"^[\[\(]+|[\]\)]+$", "", clean).strip()
    placeholder_terms = {
        "no label", "none", "unknown", "not on label", "n/a", "na",
        "[no label]", "[none]", "[unknown]", "[not on label]",
        "none specified", "no label specified"
    }
    return clean in placeholder_terms or clean_inner in placeholder_terms

class CandidateMatch:
    def __init__(self, release_dict: Dict[str, Any], score: float, reasons: List[str]):
        self.data = release_dict
        self.id = release_dict.get("id", "")
        self.title = release_dict.get("title", "")
        self.score = score
        self.reasons = reasons
        self.track_count = release_dict.get("track-count", 0)
        self.date = release_dict.get("date", "Unknown")
        self.year = self.date[:4] if self.date and self.date != "Unknown" else "Unkn"
        self.country = release_dict.get("country", "")
        self.status = release_dict.get("status", "")
        self.artist = ""
        artist_credits = release_dict.get("artist-credit", [])
        if artist_credits:
            self.artist = "".join(ac.get("name", "") + ac.get("joinphrase", "") for ac in artist_credits)
        self.labels = []
        for li in release_dict.get("label-info", []):
            cat = li.get("catalog-number")
            lbl_raw = li.get("label", {}).get("name") if li.get("label") else None
            lbl = None if is_placeholder_label(lbl_raw) else lbl_raw
            if lbl and cat:
                self.labels.append(f"{lbl} ({cat})")
            elif cat:
                self.labels.append(cat)
            elif lbl:
                self.labels.append(lbl)

def search_and_rank_candidates(
    client: MusicBrainzClient,
    folder_info: FolderInfo,
    local_tracks: List[LocalTrack],
    override_query: Optional[str] = None
) -> List[CandidateMatch]:
    raw_releases: Dict[str, Dict[str, Any]] = {}

    queries = []
    if override_query:
        queries.append(override_query)
    else:
        album_esc = escape_lucene(folder_info.album_hint)
        if folder_info.artist_hint:
            artist_esc = escape_lucene(folder_info.artist_hint)
            queries.append(f'release:"{album_esc}" AND (artist:"{artist_esc}" OR label:"{artist_esc}")')
            queries.append(f'release:"{album_esc}" AND artist:"{artist_esc}"')
        queries.append(f'release:"{album_esc}"')

        # If album hint contains subparts (e.g. subtitles separated by dashes/colons), add individual queries
        subparts = [p.strip() for p in re.split(r"[-–—:]", folder_info.album_hint) if len(p.strip()) >= 2]
        if len(subparts) > 1:
            for sp in subparts:
                sp_esc = escape_lucene(sp)
                queries.append(f'release:"{sp_esc}"')

        queries.append(f'"{album_esc}"')

    for q in queries:
        rels = client.search_releases(q, limit=15)
        for r in rels:
            rid = r.get("id")
            if rid and rid not in raw_releases:
                raw_releases[rid] = r
        if len(raw_releases) >= 8:
            break

    # Fallback to existing tags in local files if no candidates found yet and no override_query
    if not raw_releases and not override_query:
        existing_albums = {t.existing_album for t in local_tracks if t.existing_album and t.existing_album != folder_info.album_hint}
        for ex_alb in existing_albums:
            ex_esc = escape_lucene(ex_alb)
            rels = client.search_releases(f'release:"{ex_esc}"', limit=15)
            for r in rels:
                rid = r.get("id")
                if rid and rid not in raw_releases:
                    raw_releases[rid] = r
            if len(raw_releases) >= 8:
                break

    total_local = len(local_tracks)
    candidates: List[CandidateMatch] = []

    for rid, r in raw_releases.items():
        score = 0.0
        reasons = []

        r_tracks = r.get("track-count", 0)
        if r_tracks == total_local and total_local > 0:
            score += 45.0
            reasons.append(f"Exact track count match ({r_tracks})")
        elif r_tracks > 0 and total_local > 0 and abs(r_tracks - total_local) <= 2:
            score += 20.0
            reasons.append(f"Near track count match ({r_tracks} vs {total_local})")

        title = r.get("title", "")
        sim_title = difflib.SequenceMatcher(None, folder_info.album_hint.lower(), title.lower()).ratio()
        score += sim_title * 30.0
        if sim_title > 0.85:
            reasons.append(f"Strong title match ({sim_title*100:.0f}%)")

        r_artist = "".join(ac.get("name", "") for ac in r.get("artist-credit", []))
        if folder_info.artist_hint:
            sim_artist = difflib.SequenceMatcher(None, folder_info.artist_hint.lower(), r_artist.lower()).ratio()
            labels_str = " ".join(li.get("label", {}).get("name", "") for li in r.get("label-info", []) if li.get("label"))
            sim_label = difflib.SequenceMatcher(None, folder_info.artist_hint.lower(), labels_str.lower()).ratio()
            best_prefix_sim = max(sim_artist, sim_label)
            score += best_prefix_sim * 20.0
            if best_prefix_sim > 0.7:
                reasons.append(f"Artist/Label match ({best_prefix_sim*100:.0f}%)")

        r_date = r.get("date", "")
        if folder_info.year_hint and r_date.startswith(folder_info.year_hint):
            score += 15.0
            reasons.append(f"Year matched ({folder_info.year_hint})")

        if r.get("status") == "Official":
            score += 5.0

        candidates.append(CandidateMatch(r, score, reasons))

    candidates.sort(key=lambda c: c.score, reverse=True)
    return candidates

