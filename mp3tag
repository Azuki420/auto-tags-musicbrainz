def detect_file_disc_number(
    file_path: Path,
    local_tracks: List["LocalTrack"],
    disc_total: int,
    assigned_discs: Set[int]
) -> int:
    """Detects which disc number (1-indexed) a .cue or .log file belongs to."""
    # 1. Check parent directory name (e.g. CD1, Disc 2)
    m = re.search(r"(?:disc|cd|disk)\s*(\d+)", file_path.parent.name, re.IGNORECASE)
    if m:
        val = int(m.group(1))
        if 1 <= val <= max(disc_total, 99):
            return val

    # 2. Check filename for explicit disc/cd/disk indicator
    m = re.search(r"(?:disc|cd|disk)\s*(\d+)", file_path.stem, re.IGNORECASE)
    if m:
        val = int(m.group(1))
        if 1 <= val <= max(disc_total, 99):
            return val

    # 3. Check trailing or bracketed number (e.g. Album_1.cue, [2].cue)
    m = re.search(r"[\[\(._\-\s](\d{1,2})[\]\)]?$", file_path.stem)
    if m:
        val = int(m.group(1))
        if 1 <= val <= max(disc_total, 99):
            return val

    # 4. Check file content
    try:
        content = file_path.read_text(encoding="utf-8", errors="replace")[:8192]
        m_content = re.search(r"REM\s+(?:DISCNUMBER|DISC)\s+(\d+)", content, re.IGNORECASE)
        if m_content:
            return int(m_content.group(1))
        for lt in local_tracks:
            if lt.file_path.name in content and lt.disc_num is not None:
                return lt.disc_num
            if lt.file_path.stem in content and lt.disc_num is not None:
                return lt.disc_num
    except Exception:
        pass

    # 5. Fallback: lowest unassigned disc in range
    for d in range(1, max(disc_total + 1, 2)):
        if d not in assigned_discs:
            return d

    return 1

class AuxiliaryFilePlan:
    def __init__(self):
        self.playlists_to_remove: List[Path] = []
        self.files_to_rename: List[Tuple[Path, Path]] = []

def plan_auxiliary_files(
    target_dir: Path,
    base_album_name: str,
    release_meta: "ReleaseMetadata",
    discs_found: int,
    local_tracks: List["LocalTrack"]
) -> AuxiliaryFilePlan:
    plan = AuxiliaryFilePlan()
    is_multi_disc = (release_meta.disc_total > 1) or (discs_found > 1)

    all_files: List[Path] = []
    for root, _, files in os.walk(target_dir):
        for f in files:
            all_files.append(Path(root) / f)

    # 1. Playlists to remove (.m3u8 and .m3u)
    for p in all_files:
        if p.suffix.lower() in (".m3u8", ".m3u"):
            plan.playlists_to_remove.append(p)

    # 2. CUE files to rename
    cue_files = sorted([p for p in all_files if p.suffix.lower() == ".cue"])
    assigned_cue_discs: Set[int] = set()
    for p in cue_files:
        if not is_multi_disc:
            target_name = f"{base_album_name}.cue"
        else:
            disc_num = detect_file_disc_number(p, local_tracks, release_meta.disc_total, assigned_cue_discs)
            assigned_cue_discs.add(disc_num)
            target_name = f"{base_album_name} [Disc {disc_num}].cue"
        target_path = p.parent / target_name
        if p.resolve() != target_path.resolve():
            plan.files_to_rename.append((p, target_path))

    # 3. LOG files to rename
    log_files = sorted([p for p in all_files if p.suffix.lower() == ".log"])
    assigned_log_discs: Set[int] = set()
    for p in log_files:
        if not is_multi_disc:
            target_name = f"{base_album_name}.log"
        else:
            disc_num = detect_file_disc_number(p, local_tracks, release_meta.disc_total, assigned_log_discs)
            assigned_log_discs.add(disc_num)
            target_name = f"{base_album_name} [Disc {disc_num}].log"
        target_path = p.parent / target_name
        if p.resolve() != target_path.resolve():
            plan.files_to_rename.append((p, target_path))

    return plan

def update_cue_file_references(cue_path: Path, assignments: List["TrackAssignment"], release_meta: "ReleaseMetadata"):
    """Updates audio file references inside a .cue sheet to match renamed audio files."""
    try:
        content = cue_path.read_text(encoding="utf-8", errors="replace")
        original_content = content
        for a in assignments:
            old_name = a.local_file.name
            old_stem = a.local_file.stem
            new_name = get_target_filename(a, release_meta)
            content = re.sub(
                rf'FILE\s+["\']({re.escape(old_name)}|{re.escape(old_stem)}\.(?:wav|flac|mp3|m4a|ogg|opus))["\']',
                f'FILE "{new_name}"',
                content,
                flags=re.IGNORECASE
            )
        if content != original_content:
            cue_path.write_text(content, encoding="utf-8")
    except Exception:
        pass

def ensure_jpeg(img_bytes: bytes) -> bytes:
    """Converts image bytes to valid JPEG format if not already genuine JPEG."""
    try:
        with Image.open(io.BytesIO(img_bytes)) as img:
            if img.format == "JPEG" and img.mode == "RGB" and img_bytes.startswith(b"\xff\xd8\xff"):
                return img_bytes

            # Handle RGBA/transparency gracefully with a white background
            if img.mode in ("RGBA", "LA") or (img.mode == "P" and "transparency" in img.info):
                bg = Image.new("RGB", img.size, (255, 255, 255))
                rgba_img = img.convert("RGBA")
                bg.paste(rgba_img, mask=rgba_img.split()[3])
                rgb_img = bg
            else:
                rgb_img = img.convert("RGB")

            out = io.BytesIO()
            rgb_img.save(out, format="JPEG", quality=95)
            return out.getvalue()
    except Exception as e:
        if img_bytes.startswith(b"\xff\xd8\xff"):
            return img_bytes
        UI.warn(f"Failed to convert image to JPEG: {e}")
        return img_bytes

class LocalCoverInfo:
    def __init__(self, source_path: Path, jpeg_bytes: bytes, needs_rename_or_convert: bool, score: float):
        self.source_path = source_path
        self.jpeg_bytes = jpeg_bytes
        self.needs_rename_or_convert = needs_rename_or_convert
        self.score = score

def score_cover_candidate(path: Path) -> float:
    name_lower = path.name.lower()
    stem_lower = path.stem.lower()
    score = 0.0

    # Explicit albumart.jpg gets top priority
    if name_lower == "albumart.jpg":
        return 1000.0
    if stem_lower == "albumart":
        score += 300.0

    # Common front cover keywords
    if any(k in stem_lower for k in ("cover", "front", "folder")):
        score += 200.0
    elif any(k in stem_lower for k in ("artwork", "art")):
        score += 80.0
    elif any(k in stem_lower for k in ("scan", "sleeve")):
        score += 40.0

    # Heavily penalize non-front images (back, tray, booklet, cd, etc.)
    if any(k in stem_lower for k in ("back", "rear", "tray", "inlay", "booklet", "cd", "disc", "inside", "spine", "matrix", "label")):
        score -= 200.0

    try:
        with Image.open(path) as img:
            w, h = img.size
            if w > 0 and h > 0:
                ratio = min(w, h) / max(w, h)
                if ratio >= 0.85:
                    score += 60.0  # Square album art
                elif ratio >= 0.7:
                    score += 20.0

                if min(w, h) >= 500:
                    score += 40.0
                elif min(w, h) >= 300:
                    score += 20.0
                elif min(w, h) < 150:
                    score -= 50.0  # Thumbnail or icon

                # Tie-breaker favoring higher resolution
                score += min(w, h) * 0.005
    except Exception:
        return -1000.0

    return score

def find_local_cover_art(target_dir: Path) -> Optional[LocalCoverInfo]:
    """
    Searches target folder (and immediate subdirectories if needed) for already existing
    album art or cover image, including random filenames.
    Returns LocalCoverInfo with converted JPEG bytes and whether rename/conversion is needed.
    """
    candidates: List[Path] = []

    # 1. Search root target directory
    for f in target_dir.iterdir():
        if f.is_file() and not f.name.startswith("."):
            ext = f.suffix.lower()
            if ext in AUDIO_EXTENSIONS or ext in (".cue", ".log", ".m3u", ".m3u8", ".nfo", ".sfv", ".txt", ".md", ".json", ".xml"):
                continue
            if ext in IMAGE_EXTENSIONS:
                candidates.append(f)
            else:
                try:
                    with Image.open(f) as img:
                        img.verify()
                    candidates.append(f)
                except Exception:
                    pass

    # 2. If no images found in root, check one level of subdirectories (e.g. CD1, Scans, Artwork)
    if not candidates:
        for sub in target_dir.iterdir():
            if sub.is_dir() and not sub.name.startswith("."):
                for f in sub.iterdir():
                    if f.is_file() and not f.name.startswith("."):
                        ext = f.suffix.lower()
                        if ext in IMAGE_EXTENSIONS:
                            candidates.append(f)

    if not candidates:
        return None

    # Score all candidate images
    scored = []
    for c in candidates:
        sc = score_cover_candidate(c)
        scored.append((c, sc))

    scored.sort(key=lambda x: x[1], reverse=True)
    best_file, best_score = scored[0]

    # If multiple files exist and best score is <= 0 (all are back/cd/etc.), ignore
    if best_score <= 0 and len(candidates) > 1:
        return None

    try:
        raw_bytes = best_file.read_bytes()
        jpeg_bytes = ensure_jpeg(raw_bytes)

        target_albumart = target_dir / "albumart.jpg"
        needs_change = (
            best_file.resolve() != target_albumart.resolve() or
            raw_bytes != jpeg_bytes or
            best_file.name != "albumart.jpg"
        )
        return LocalCoverInfo(
            source_path=best_file,
            jpeg_bytes=jpeg_bytes,
            needs_rename_or_convert=needs_change,
            score=best_score
        )
    except Exception as e:
        UI.warn(f"Failed to read/process local cover {best_file.name}: {e}")
        return None

# -----------------------------------------------------------------------------
# Catalog Number Resolver
# -----------------------------------------------------------------------------
def resolve_catalog_numbers(label_info_list: List[Dict[str, Any]], disc_total: int) -> Dict[int, str]:
    """
    Returns a dict mapping disc_number (1-indexed) -> catalog_number string.
    If multiple catalog numbers are provided (either across multiple label-info entries or in a range/comma/slash),
    each disc gets its distinct catalog number.
    If only 1 catalog number is provided and cannot be expanded as a range, all discs use that one.
    """
    if not label_info_list:
        return {d: "" for d in range(1, disc_total + 1)}

    raw_cats = []
    for li in label_info_list:
        cat = li.get("catalog-number")
        if cat and str(cat).strip():
            raw_cats.append(str(cat).strip())

    if not raw_cats:
        return {d: "" for d in range(1, disc_total + 1)}

    # Case 1: Multiple catalog numbers provided across label-info entries
    if len(raw_cats) > 1:
        disc_cats = {}
        for d in range(1, disc_total + 1):
            disc_cats[d] = raw_cats[d - 1] if d <= len(raw_cats) else raw_cats[-1]
        return disc_cats

    # Case 2: Exactly 1 catalog number provided. Check if it contains a range or slash/comma list
    single = raw_cats[0]

    # Check comma or slash or semicolon separated list: e.g. "IMAE-00046 / IMAE-00047"
    if any(sep in single for sep in [" / ", " /", "/ ", ", ", ","]):
        parts = [p.strip() for p in re.split(r"[/,;]", single) if p.strip()]
        if len(parts) >= disc_total:
            return {d: parts[d - 1] for d in range(1, disc_total + 1)}

    # Check range notation: e.g. LC-2545~54, IMAE-00046~47, IMAE-00046~7, ABC-001-3
    m = re.match(r"^(.*?)(\d+)\s*[~/–-]\s*(\d+)$", single)
    if m:
        prefix, start_str, end_str = m.group(1), m.group(2), m.group(3)
        start_num = int(start_str)
        if len(end_str) < len(start_str):
            cutoff = len(start_str) - len(end_str)
            full_end_str = start_str[:cutoff] + end_str
            end_num = int(full_end_str)
        else:
            end_num = int(end_str)

        count = end_num - start_num + 1
        if count >= disc_total or count > 1:
            pad_len = len(start_str)
            disc_cats = {}
            for idx, num in enumerate(range(start_num, start_num + disc_total), 1):
                disc_cats[idx] = f"{prefix}{num:0{pad_len}d}"
            return disc_cats

    # Case 3: Only 1 catalog number provided without range
    return {d: single for d in range(1, disc_total + 1)}

# -----------------------------------------------------------------------------
# Rate-Limited MusicBrainz Client
# -----------------------------------------------------------------------------
class MusicBrainzClient:
    BASE_URL = "https://musicbrainz.org/ws/2"
    COVER_URL = "https://coverartarchive.org"

    def __init__(self, min_interval: float = 1.0):
        self.min_interval = min_interval
        self.last_req_time = 0.0
        self.session = requests.Session()
        self.session.headers.update({"User-Agent": USER_AGENT})

    def _throttle(self):
        elapsed = time.time() - self.last_req_time
        if elapsed < self.min_interval:
            time.sleep(self.min_interval - elapsed)
        self.last_req_time = time.time()

    def get_json(self, url: str, params: Optional[Dict[str, str]] = None) -> Optional[Dict[str, Any]]:
        self._throttle()
        for attempt in range(3):
            try:
                r = self.session.get(url, params=params, timeout=15)
                if r.status_code == 200:
                    return r.json()
                elif r.status_code == 404:
                    return None
                elif r.status_code in (503, 429):
                    time.sleep(1.5 * (attempt + 1))
                    continue
                else:
                    return None
            except requests.RequestException:
                time.sleep(1.0)
        return None

    def search_releases(self, query: str, limit: int = 15) -> List[Dict[str, Any]]:
        url = f"{self.BASE_URL}/release/"
        params = {"query": query, "limit": str(limit), "fmt": "json"}
        data = self.get_json(url, params=params)
        return data.get("releases", []) if data else []

    def get_release_details(self, release_id: str) -> Optional[Dict[str, Any]]:
        url = f"{self.BASE_URL}/release/{release_id}"
        params = {
            "inc": "recordings+artists+labels+media+release-groups+discids",
            "fmt": "json"
        }
        return self.get_json(url, params=params)

    def get_release_group_releases(self, release_group_id: str) -> List[Dict[str, Any]]:
        url = f"{self.BASE_URL}/release-group/{release_group_id}"
        params = {"inc": "releases+artists+media", "fmt": "json"}
        data = self.get_json(url, params=params)
        if not data:
            return []
        releases = data.get("releases", [])
        for r in releases:
            if "track-count" not in r or not r.get("track-count"):
                media_list = r.get("media", [])
                total_t = sum(m.get("track-count", 0) for m in media_list)
                if total_t > 0:
                    r["track-count"] = total_t
        return releases

    def fetch_cover_art(self, release_id: str, release_group_id: Optional[str] = None) -> Optional[Tuple[bytes, str]]:
        urls_to_try = [
            f"{self.COVER_URL}/release/{release_id}/front-1200",
            f"{self.COVER_URL}/release/{release_id}/front",
        ]
        if release_group_id:
            urls_to_try.append(f"{self.COVER_URL}/release-group/{release_group_id}/front")

        for u in urls_to_try:
            try:
                r = self.session.get(u, timeout=15, allow_redirects=True)
                if r.status_code == 200 and r.content:
                    content = r.content
                    mime = "image/jpeg"
                    if content.startswith(b"\x89PNG\r\n\x1a\n"):
                        mime = "image/png"
                    elif content.startswith(b"\xff\xd8\xff"):
                        mime = "image/jpeg"
                    return content, mime
            except requests.RequestException:
                continue
        return None

# -----------------------------------------------------------------------------
# Folder Parsing & Query Construction
# -----------------------------------------------------------------------------
class FolderInfo:
    def __init__(self, folder_path: Path):
        self.path = folder_path.resolve()
        self.name = folder_path.name
        self.artist_hint: Optional[str] = None
        self.album_hint: str = self.name
        self.year_hint: Optional[str] = None
        self._parse()

    def _parse(self):
        clean = self.name
        m_year = re.search(r"[\[\(](\d{4})(?:-\d{2}-\d{2})?[\]\)]", clean)
        if m_year:
            self.year_hint = m_year.group(1)
            clean = clean.replace(m_year.group(0), " ").strip()

        clean = re.sub(
            r"[\[\(](?:flac|mp3|wav|cd|web|vinyl|\d{2,4}k|\d{2,4}kbps|24bit|16bit|cbr|vbr|remastered|ost)[\]\)]",
            "", clean, flags=re.IGNORECASE
        )
        clean = re.sub(r"\[[^\]]*\]|\([^\)]*\)", " ", clean)
        clean = re.sub(r"\s+", " ", clean).strip()

        sep_match = re.search(r"\s+[-–—]\s+|\s*[-–—]\s+(?=\S)|(?<=\S)\s+[-–—]\s*", clean)
        if sep_match:
            self.artist_hint = clean[:sep_match.start()].strip()
            raw_album = clean[sep_match.end():].strip()
            self.album_hint = re.sub(r"[\s\-–—~_]+$", "", raw_album).strip()
            return

        self.album_hint = re.sub(r"[\s\-–—~_]+$", "", clean).strip()

